<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>HP_34401A</RootNamespace>
    <AssemblyName>HP 34401A</AssemblyName>
    <ApplicationIcon>34401A_Logo.ico</ApplicationIcon>

    <!-- Keep the old code compiling exactly as it did on .NET Framework -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Properties\AssemblyInfo.cs already defines these attributes -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
  </PropertyGroup>

  <ItemGroup>
    <!-- ScottPlot 4 (the code uses ScottPlot.Plottable / ScottPlot.Statistics.Histogram / Plot.AddSignal etc.) -->
    <PackageReference Include="ScottPlot.WPF" Version="4.1.74" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Ookii.Dialogs.Wpf" Version="5.0.1" />

    <!-- These were built into .NET Framework; on .NET 10 they are NuGet packages -->
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="System.Speech" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="34401A_Logo.ico" />
    <!-- 14-segment VFD display font (modified DSEG14 Classic, SIL Open Font License 1.1) -->
    <Resource Include="Fonts\HP34401A-VFD-Light.ttf" />
    <Resource Include="Fonts\HP34401A-VFD-Regular.ttf" />
    <Resource Include="Fonts\HP34401A-VFD-Bold.ttf" />
    <None Include="Fonts\OFL-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Leftovers from the .NET Framework project: not used by this build -->
  <ItemGroup>
    <None Remove="packages.config;OpenTK.dll.config" />
    <Compile Remove="packages\**;bin\**;obj\**" />
    <Page Remove="packages\**;bin\**;obj\**" />
    <None Remove="packages\**" />
  </ItemGroup>

</Project>
