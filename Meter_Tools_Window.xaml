<Window x:Class="HP_34401A.Meter_Tools_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HP 34401A Meter Tools" Width="470" Height="470" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner" FontSize="13">
    <TabControl Margin="4">
        <TabItem Header="Math">
            <StackPanel Margin="10,8,10,8">
                <TextBlock x:Name="Math_Status" Text="Math: Off" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

                <RadioButton x:Name="Math_Off" Content="Off (normal readings)" GroupName="Math" IsChecked="True" Margin="0,2"/>

                <RadioButton x:Name="Math_Null" Content="Null (reading minus offset)" GroupName="Math" Margin="0,8,0,2"/>
                <StackPanel Orientation="Horizontal" Margin="22,2,0,0">
                    <TextBlock Text="Offset:" Width="115" VerticalAlignment="Center"/>
                    <TextBox x:Name="Null_Offset" Width="110"/>
                    <TextBlock Text="  blank = next reading" Foreground="Gray" VerticalAlignment="Center"/>
                </StackPanel>

                <RadioButton x:Name="Math_dB" Content="dB (DC V and AC V only)" GroupName="Math" Margin="0,8,0,2"/>
                <StackPanel Orientation="Horizontal" Margin="22,2,0,0">
                    <TextBlock Text="Reference (dBm):" Width="115" VerticalAlignment="Center"/>
                    <TextBox x:Name="DB_Ref" Width="110"/>
                    <TextBlock Text="  blank = next reading" Foreground="Gray" VerticalAlignment="Center"/>
                </StackPanel>

                <RadioButton x:Name="Math_dBm" Content="dBm (DC V and AC V only)" GroupName="Math" Margin="0,8,0,2"/>
                <StackPanel Orientation="Horizontal" Margin="22,2,0,0">
                    <TextBlock Text="Reference (Ω):" Width="115" VerticalAlignment="Center"/>
                    <ComboBox x:Name="DBM_Ref" Width="110">
                        <ComboBoxItem Content="50"/>
                        <ComboBoxItem Content="75"/>
                        <ComboBoxItem Content="93"/>
                        <ComboBoxItem Content="110"/>
                        <ComboBoxItem Content="124"/>
                        <ComboBoxItem Content="125"/>
                        <ComboBoxItem Content="135"/>
                        <ComboBoxItem Content="150"/>
                        <ComboBoxItem Content="250"/>
                        <ComboBoxItem Content="300"/>
                        <ComboBoxItem Content="500"/>
                        <ComboBoxItem Content="600" IsSelected="True"/>
                        <ComboBoxItem Content="800"/>
                        <ComboBoxItem Content="900"/>
                        <ComboBoxItem Content="1000"/>
                        <ComboBoxItem Content="1200"/>
                        <ComboBoxItem Content="8000"/>
                    </ComboBox>
                </StackPanel>

                <RadioButton x:Name="Math_Limit" Content="Limit test (display shows HI / LO in red)" GroupName="Math" Margin="0,8,0,2"/>
                <StackPanel Orientation="Horizontal" Margin="22,2,0,0">
                    <TextBlock Text="Lower:" Width="50" VerticalAlignment="Center"/>
                    <TextBox x:Name="Limit_Low" Width="100"/>
                    <TextBlock Text="Upper:" Width="50" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="Limit_High" Width="100"/>
                </StackPanel>

                <Button x:Name="Math_Apply" Content="Apply" Width="110" Height="28" HorizontalAlignment="Left" Margin="0,14,0,6" Click="Math_Apply_Click"/>
                <TextBlock x:Name="Math_Message" TextWrapping="Wrap" Foreground="Firebrick"/>
                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,4,0,0"
                           Text="Values use the current function's units (e.g. V, Ω, Hz). Changing the measurement function turns math off."/>
            </StackPanel>
        </TabItem>
        <TabItem Header="Burst Capture">
            <StackPanel Margin="10,8,10,8">
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="Takes a block of readings at full meter speed into the meter's memory (max 512), then transfers them in one go. Normal reading pauses while it runs."/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Number of readings (2–512):" VerticalAlignment="Center" Width="185"/>
                    <TextBox x:Name="Burst_Count" Text="100" Width="80"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,10,0,0"
                           Text="Fastest: NPLC 0.02, Auto Zero Off, a fixed range and the meter display off. Slowest: at NPLC 10 with auto zero on, 512 readings take about 3 minutes."/>
                <Button x:Name="Burst_Start" Content="Start Burst" Width="110" Height="28" HorizontalAlignment="Left" Margin="0,14,0,10" Click="Burst_Start_Click"/>
                <TextBlock x:Name="Burst_Result" TextWrapping="Wrap"/>
                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,10,0,0"
                           Text="Readings also go to the display, graph, table and log files. A CSV file per burst is saved in the Burst folder of the log data directory. Timestamps are spread evenly over the measured acquisition time."/>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
